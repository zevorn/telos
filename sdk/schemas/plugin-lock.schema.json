{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://telos.dev/schemas/plugin-lock-v1.json",
    "title": "Telos Plugin Lock v1",
    "type": "object",
    "required": ["format", "source_hash", "dependencies"],
    "properties": {
        "format": {"const": 1},
        "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependencies": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "version", "source", "sha256"],
                "properties": {
                    "name": {"type": "string"},
                    "version": {"type": "string"},
                    "source": {"type": "string"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
